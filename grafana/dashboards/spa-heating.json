{
  "annotations": {"list": []},
  "description": "Teplota vody, topení, heating curve samples a predikce",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "liveNow": true,
  "panels": [
    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "max": 45,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "yellow", "value": 28},
              {"color": "orange", "value": 33},
              {"color": "red", "value": 38}
            ]
          },
          "unit": "celsius"
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"solarguard\") |> range(start: -10m) |> filter(fn: (r) => r._measurement == \"spa\" and r._field == \"water_temp_c\") |> last()",
          "refId": "A"
        }
      ],
      "title": "Teplota vody",
      "type": "gauge"
    },
    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "blue", "index": 0, "text": "VYP"}, "1": {"color": "red", "index": 1, "text": "TOPÍ"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"solarguard\") |> range(start: -10m) |> filter(fn: (r) => r._measurement == \"spa\" and r._field == \"heater_on\") |> last() |> map(fn: (r) => ({r with _value: if r._value then 1 else 0}))",
          "refId": "A"
        }
      ],
      "title": "Stav topení",
      "type": "stat"
    },
    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [{"color": "purple", "value": null}]},
          "unit": "celsius"
        }
      },
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {
        "colorMode": "value", "graphMode": "none", "justifyMode": "center",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"solarguard\") |> range(start: -10m) |> filter(fn: (r) => r._measurement == \"spa\" and r._field == \"target_temp_c\") |> last()",
          "refId": "A"
        }
      ],
      "title": "Cílová teplota",
      "type": "stat"
    },
    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line", "fillOpacity": 15, "lineInterpolation": "stepAfter",
            "lineWidth": 2, "showPoints": "never", "spanNulls": true
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "water_temp_c"},
            "properties": [{"id": "custom.lineInterpolation", "value": "smooth"}, {"id": "color", "value": {"fixedColor": "blue", "mode": "fixed"}}]
          },
          {
            "matcher": {"id": "byName", "options": "target_temp_c"},
            "properties": [{"id": "color", "value": {"fixedColor": "purple", "mode": "fixed"}}, {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}]
          }
        ]
      },
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 6},
      "id": 4,
      "options": {
        "legend": {"calcs": ["last"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"solarguard\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"spa\" and (r._field == \"water_temp_c\" or r._field == \"target_temp_c\")) |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)",
          "refId": "A"
        }
      ],
      "title": "Teplota vody vs cíl",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "axisLabel": "min/°C", "axisPlacement": "auto",
            "drawStyle": "points", "lineWidth": 1,
            "pointSize": 8, "showPoints": "always"
          },
          "unit": "min"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 5,
      "options": {
        "legend": {"calcs": ["mean", "count"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"solarguard\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"heating_curve_samples\" and r._field == \"min_per_degree\")",
          "refId": "A"
        }
      ],
      "title": "Heating curve - minut na °C",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2,
            "pointSize": 5, "showPoints": "auto"
          },
          "unit": "short"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 6,
      "options": {
        "legend": {"calcs": ["last"], "displayMode": "table", "placement": "bottom"},
        "tooltip": {"mode": "multi"}
      },
      "targets": [
        {
          "datasource": {"type": "influxdb", "uid": "${DS_INFLUXDB}"},
          "query": "from(bucket: \"solarguard\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"heating_curve_samples\" and r._field == \"learned_correction\")",
          "refId": "A"
        }
      ],
      "title": "Learned correction (1.0 = fyzika)",
      "type": "timeseries"
    }
  ],
